# Copiez ce fichier vers .env.local et renseignez votre mot de passe PostgreSQL.
DATABASE_URL=postgres://postgres:VOTRE_MOT_DE_PASSE@localhost:5432/diapason

# Adresse publique du site une fois en ligne (sert au sitemap et au robots.txt).
# Sans cette ligne, l'adresse utilisée est http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://votre-domaine.example

# Référencement — à renseigner une fois le site en ligne (voir « Référencement » dans le README).
# Codes de vérification de propriété, donnés par chaque outil (méthode « balise HTML ») :
# GOOGLE_SITE_VERIFICATION=code-fourni-par-google-search-console
# BING_SITE_VERIFICATION=code-fourni-par-bing-webmaster-tools
# Clé IndexNow, pour signaler les pages à Bing (npm run seo:indexnow -- --cle en propose une) :
# INDEXNOW_KEY=
